// Cloudflare Workers static-assets config.
// Only ./site is published.
{
  "name": "please-official-website",
  "compatibility_date": "2026-09-29",
  "main": "worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/download", "/download/"],
    "not_found_handling": "404-page"
  }
}

